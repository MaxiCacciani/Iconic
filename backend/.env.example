# Copiar a .env y completar. Nunca commitear .env.
ENTORNO=local

# Local sin Docker → SQLite (las tablas salen de los modelos)
DATABASE_URL=sqlite:///./iconic.db
# Con PostgreSQL local:
# DATABASE_URL=postgresql+psycopg://iconic:iconic@localhost:5432/iconic

# Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_MINUTOS=60

# Cloudflare R2 (bucket privado)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_URL_TTL_SEGUNDOS=300
